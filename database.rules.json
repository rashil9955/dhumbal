{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('meta/host').val() === auth.uid",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('host').val() === auth.uid"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 14" }
          }
        },
        "state": {
          ".read": "auth != null"
        },
        "hands": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "actions": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid"
          }
        }
      }
    }
  }
}
